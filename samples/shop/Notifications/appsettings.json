// Настройки по умолчанию — для dotnet run на машине при поднятом стенде песочницы и проекте demo-shop
// (samples/shop/setup.sh). В Docker — переменные окружения (samples/shop/compose.yaml).
{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  // Вызывают только сервисы проекта по ключу: токен ключа с правами в «Уведомлениях» адресован им (aud=notifications).
  "Authentication": {
    "Authority": "http://localhost:8180/realms/demo-shop",
    "Audience": "notifications",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": { "Redis": "localhost:6379" },
  "Notifications": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "From": "no-reply@demo-shop.test"
  },
  // Свой ключ «Уведомлений» (права service.users.read — телефон и почта получателя, service.catalog.declare — свои
  // права из кода). Адрес сервера входа — из Authentication, секрет — ServiceToken__ClientSecretFile или __ClientSecret.
  "AuthService": { "BaseUrl": "http://localhost:8082/" },
  "ServiceToken": { "ClientId": "service-notifications" }
}
