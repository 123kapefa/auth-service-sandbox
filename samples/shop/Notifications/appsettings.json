// Настройки по умолчанию — для dotnet run на машине при поднятом стенде песочницы и проекте demo-shop
// (samples/shop/setup.sh). В Docker — переменные окружения (samples/shop/compose.yaml).
{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  // Вызывают только сервисы проекта по ключу. Токен сервиса адресован сервису входа (aud=auth-api) —
  // другого адресата у токенов по ключу сейчас нет (журнал трений, docs/keycloak/06a-friction.md).
  "Authentication": {
    "Authority": "http://localhost:8180/realms/demo-shop",
    "Audience": "auth-api",
    "AccessTokenCookie": "",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": { "Redis": "localhost:6379" },
  // Кому можно присылать уведомления: client_id ключей сервисов проекта.
  "Notifications": {
    "AllowedServices": [ "service-orders" ],
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "From": "no-reply@demo-shop.test"
  },
  // Свой ключ «Уведомлений» (право service.users.read): узнать у сервиса входа телефон и почту получателя.
  "AuthService": { "BaseUrl": "http://localhost:8082/" },
  "ServiceToken": {
    "Authority": "http://localhost:8180/realms/demo-shop",
    "ClientId": "service-notifications"
  }
}
