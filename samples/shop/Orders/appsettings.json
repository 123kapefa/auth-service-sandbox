// Настройки по умолчанию — для dotnet run на машине при поднятом стенде песочницы и проекте demo-shop
// (samples/shop/setup.sh). В Docker — переменные окружения (samples/shop/compose.yaml).
{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Shop": { "Name": "Демо-магазин", "LoginClient": "orders-web" },
  // Токены пользователей: realm проекта, адресат — приложение «Заказы»; только заголовок Authorization.
  "Authentication": {
    "Authority": "http://localhost:8180/realms/demo-shop",
    "Audience": "orders",
    "AccessTokenCookie": "",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": { "Redis": "localhost:6379" },
  // Ключ «Заказов» — выдаёт админ проекта («Сервисы и ключи»), секрет — ServiceToken__ClientSecret из окружения.
  "ServiceToken": {
    "Authority": "http://localhost:8180/realms/demo-shop",
    "ClientId": "service-orders"
  },
  "Notifications": { "BaseUrl": "http://localhost:5310/" },
  // Сервис входа проекта — сюда «Заказы» при старте объявляют свои права и роли (AddAppCatalog).
  "AuthService": { "BaseUrl": "http://localhost:8082/" }
}
