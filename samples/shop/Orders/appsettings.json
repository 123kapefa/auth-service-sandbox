// Настройки по умолчанию — для dotnet run на машине при поднятом стенде песочницы и проекте demo-shop
// (samples/shop/setup.sh). В Docker — переменные окружения (samples/shop/compose.yaml).
{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  // AuthServiceUrl — внешний адрес сервиса входа проекта: модуль входа страницы и личный кабинет (смена режима).
  "Shop": { "Name": "Демо-магазин", "LoginClient": "orders-web", "AuthServiceUrl": "http://localhost:8082" },
  // Токены пользователей: realm проекта, адресат — приложение «Заказы»; токен — из заголовка Authorization.
  "Authentication": {
    "Authority": "http://localhost:8180/realms/demo-shop",
    "Audience": "orders",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": { "Redis": "localhost:6379" },
  // Ключ «Заказов» — выдаёт админ проекта («Сервисы и ключи»). Адрес сервера входа — из Authentication, секрет —
  // ServiceToken__ClientSecretFile (файл: перевыпуск без перезапуска) или ServiceToken__ClientSecret.
  "ServiceToken": { "ClientId": "service-orders" },
  "Notifications": { "BaseUrl": "http://localhost:5310/" },
  // Сервис входа проекта — сюда «Заказы» при старте объявляют свои права и роли (AddAppCatalog).
  "AuthService": { "BaseUrl": "http://localhost:8082/" }
}
