<?xml version="1.0" encoding="utf-8"?>
<!-- Как в deploy/nuget.config.example: пакеты Platform.* — из фида сервиса входа, остальное — nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="platform-auth" value="../../artifacts/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="platform-auth">
      <package pattern="Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
