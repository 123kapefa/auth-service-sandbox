# Стенд без хранилища секретов: заглушки разработки ниже. С хранилищем (docs/secrets.md) секреты отсюда убирает
# scripts/secrets/seed.sh --strip-env, а стенд поднимается через scripts/secrets/run.sh.
POSTGRES_DB=auth_service
POSTGRES_USER=auth_service
POSTGRES_PASSWORD=development-only
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
REDIS_PORT=6379

# Keycloak (только для локальной разработки)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=development-only
SANDBOX_BFF_CLIENT_SECRET=development-bff-secret
# Временный клиент переноса пользователей из боевого сервиса (этап 6).
LEGACY_IMPORT_CLIENT_SECRET=development-legacy-import-secret
# Разрешение на регистрацию клиентов (ключи сервисов проекта): выдаёт scripts/keycloak/registration-token.sh --write-env.
KEYCLOAK_REGISTRATION_TOKEN=

# Вход через Госуслуги и Яндекс ID (docs/keycloak/09-external-login.md). Не заданы — заглушка idp-stub на этом порту.
IDP_STUB_PORT=8190
# Настоящий Яндекс ID (приложение на oauth.yandex.ru, Redirect URI — http://localhost:8180/realms/sandbox/broker/yandex/endpoint):
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_AUTHORIZATION_URL=https://oauth.yandex.ru/authorize
# YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
# YANDEX_USER_INFO_URL=https://login.yandex.ru/info?format=json
# Настоящие Госуслуги (система зарегистрирована в ЕСИА; тестовая среда — https://esia-portal1.test.gosuslugi.ru):
# ESIA_CLIENT_ID=
# ESIA_AUTHORIZATION_URL=https://esia.gosuslugi.ru/aas/oauth2/v2/ac
# ESIA_TOKEN_URL=https://esia.gosuslugi.ru/aas/oauth2/v3/te
# ESIA_API_URL=https://esia.gosuslugi.ru
# ESIA_SIGNER_URL=        # сервис подписи ГОСТ: POST текста → подпись base64
# ESIA_CERTIFICATE_HASH=
