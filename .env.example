POSTGRES_DB=auth_service
POSTGRES_USER=auth_service
POSTGRES_PASSWORD=development-only
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
REDIS_PORT=6379

# Keycloak (только для локальной разработки)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=development-only
SANDBOX_BFF_CLIENT_SECRET=development-bff-secret
# Временный клиент переноса пользователей из боевого сервиса (этап 6).
LEGACY_IMPORT_CLIENT_SECRET=development-legacy-import-secret
# Разрешение на регистрацию клиентов (ключи сервисов проекта): выдаёт scripts/keycloak/registration-token.sh --write-env.
KEYCLOAK_REGISTRATION_TOKEN=
