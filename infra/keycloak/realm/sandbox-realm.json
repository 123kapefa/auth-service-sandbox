{
  "realm": "sandbox",
  "enabled": true,
  "displayName": "Auth Sandbox",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(8) and maxLength(128) and notUsername",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "loginTheme": "sandbox",
  "browserFlow": "sandbox browser",
  "authenticationFlows": [
    {
      "alias": "sandbox browser",
      "description": "Вход в браузере: как встроенный browser, но 2FA — OTP или код восстановления",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "priority": 10
        },
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "userSetupAllowed": false,
          "authenticator": "identity-provider-redirector",
          "priority": 25
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "userSetupAllowed": false,
          "priority": 30,
          "flowAlias": "sandbox forms"
        }
      ]
    },
    {
      "alias": "sandbox forms",
      "description": "Логин и пароль, затем 2FA, если пользователь её включил",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "userSetupAllowed": false,
          "priority": 20,
          "flowAlias": "sandbox conditional 2FA"
        }
      ]
    },
    {
      "alias": "sandbox conditional 2FA",
      "description": "2FA только для тех, кто её настроил; вошедшим по passkey не нужна",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured",
          "priority": 10
        },
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "userSetupAllowed": false,
          "authenticator": "conditional-credential",
          "authenticatorConfig": "sandbox-conditional-credential",
          "priority": 20
        },
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "priority": 30
        },
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "userSetupAllowed": false,
          "authenticator": "auth-recovery-authn-code-form",
          "priority": 40
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sandbox-conditional-credential",
      "config": {
        "credentials": "webauthn-passwordless"
      }
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@sandbox.test",
    "fromDisplayName": "Auth Sandbox",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "localizationTexts": {
    "ru": {
      "usernameOrEmail": "Телефон или почта"
    },
    "en": {
      "usernameOrEmail": "Phone or email"
    }
  },
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "default-roles-sandbox",
        "description": "Роли, которые получает каждый новый пользователь",
        "composite": true,
        "composites": {
          "client": {
            "sandbox-api": [
              "customer"
            ]
          }
        }
      }
    ],
    "client": {
      "sandbox-api": [
        {
          "name": "customer",
          "description": "Покупатель (есть у всех)"
        },
        {
          "name": "manager",
          "description": "Менеджер"
        },
        {
          "name": "admin",
          "description": "Администратор"
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-sandbox"
  },
  "clientScopes": [
    {
      "name": "sandbox-contract",
      "protocol": "openid-connect",
      "description": "Контракт токена: role, available_roles, active_mode, phone, aud",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "sandbox-api",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "available_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "sandbox-api",
            "claim.name": "available_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "active_mode",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "active_mode",
            "claim.name": "active_mode",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "phone",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phone",
            "claim.name": "phone",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sandbox-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "openid-min",
      "protocol": "openid-connect",
      "description": "Только sub (встроенные scopes не используются)",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "sandbox-contract",
    "openid-min"
  ],
  "clients": [
    {
      "clientId": "sandbox-api",
      "name": "Sandbox API (носитель ролей и audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "sandbox-bff",
      "name": "BFF: вход, cookie, refresh, logout, Admin API",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SANDBOX_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/auth/callback",
        "http://localhost:5080/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5080/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "sandbox-contract",
        "openid-min"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "dev-cli",
      "name": "ТОЛЬКО DEV: токен по логину/паролю для отладки",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "sandbox-contract",
        "openid-min"
      ],
      "optionalClientScopes": []
    }
  ],
