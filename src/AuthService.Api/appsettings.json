// Общее для любого проекта. Сервис входа — компонент: в каждом проекте (realm Keycloak) его клиенты называются
// одинаково — auth-api (носитель ролей и прав, адресат токенов) и auth-bff (вход); отличается только realm
// (Authentication:Authority). Демо-проект песочницы (realm sandbox, sandbox-api, sandbox-bff) — в Development и Docker.
{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Authentication": {
    "Audience": "auth-api"
  },
  "Keycloak": {
    "ClientId": "auth-bff"
  },
  "ReturnUrls": {
    "Default": "/account/"
  }
}
