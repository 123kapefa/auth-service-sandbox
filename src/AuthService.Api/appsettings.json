// Общее для любого проекта. Сервис входа — компонент: в каждом проекте (realm Keycloak) его клиенты называются
// одинаково — auth-api (носитель ролей и прав, адресат токенов) и auth-bff (вход); отличается только realm
// (Authentication:Authority). Демо-проект песочницы (realm sandbox, sandbox-api, sandbox-bff) — в Development и Docker.
{
  "AllowedHosts": "*",
  // Журнал — строки JSON в stdout (для сборщика логов): время в UTC, область запроса (TraceId, SpanId, Project, RequestId).
  // Токенов, кодов, паролей и данных людей в нём нет; строку запроса к Keycloak .NET заменяет на «?*». В Development — обычный текст.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // «Request starting … GET /auth/callback?code=…&state=…»: ASP.NET Core пишет в журнал адрес запроса со строкой запроса, то есть
      // с одноразовым кодом входа и state. Правило для этой категории нужно в каждой конфигурации: общий уровень Microsoft.AspNetCore
      // легко поднять до Information при отладке, и код ушёл бы в журнал.
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      // «Executing RedirectResult, redirecting to https://id…/auth?state=…»: адрес перехода на страницу входа и обратно со всей строкой запроса.
      "Microsoft.AspNetCore.Http.Result": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "Authentication": {
    // Админка и кабинет ходят с cookie сервиса (BFF): токен — из неё, если нет заголовка Authorization. Имя cookie
    // (AccessTokenCookie) сервис задаёт сам по Cookies:Secure — AuthenticationConfiguration.
    "Audience": "auth-api"
  },
  "Keycloak": {
    "ClientId": "auth-bff"
  },
  // Метрики Prometheus (/metrics) — на отдельном порту, наружу не публикуется; 0 — выключены.
  "Metrics": {
    "Port": 9100
  },
  "ReturnUrls": {
    "Default": "/account/"
  }
}
