{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=auth_service;Username=auth_service;Password=development-only",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      // Без запросов со строкой запроса: в ней код входа и state (см. appsettings.json).
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Http.Result": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    // В разработке журнал читает человек: обычный текст, а не JSON.
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "IncludeScopes": false }
    }
  },
  // Демо-проект песочницы: realm sandbox со своими именами клиентов.
  "Authentication": {
    "Authority": "http://localhost:8180/realms/sandbox",
    "Audience": "sandbox-api",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "ClientId": "sandbox-bff",
    "ClientSecret": "development-bff-secret"
  },
  // Демо-страница разработчика (/dev/) — только на стенде и в разработке; в Production включить нельзя.
  "DemoPage": {
    "Enabled": true
  },
  "Metrics": {
    "Port": 0
  },
  "Cookies": {
    "Secure": false
  },
  "ReturnUrls": {
    "AllowedOrigins": [
      "http://localhost:5080",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  }
}
