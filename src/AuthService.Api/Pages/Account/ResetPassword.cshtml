@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Новый пароль";
}
<h1>Новый пароль</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <p class="@(Model.Succeeded ? "success" : "error")">@Model.Message</p> }
<form method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Code" />
    <label>Новый пароль <input asp-for="Password" type="password" autocomplete="new-password" /></label>
    <button type="submit">Сохранить пароль</button>
</form>
