@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}
<h1>Восстановление пароля</h1>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <p class="success">@Model.Message</p> }
<form method="post">
    <label>Email <input asp-for="Email" autocomplete="email" /></label>
    <button type="submit">Отправить ссылку</button>
</form>
