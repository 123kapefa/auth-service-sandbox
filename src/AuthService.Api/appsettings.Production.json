// Production: общее для боя любого проекта. Проект и адреса — из окружения развёртывания (deploy/compose.yaml,
// deploy/.env.example); без обязательных значений сервис не стартует и пишет, чего не хватает:
//   Authentication__Authority — realm проекта (https://id.example.com/realms/shop);
//   Authentication__MetadataAddress — если сервис видит сервер входа по внутреннему адресу (iss остаётся Authority);
//   ConnectionStrings__AuthDb, ConnectionStrings__Redis;
//   Keycloak__ClientSecret — секрет клиента auth-bff; Keycloak__RegistrationToken — разрешение на ключи сервисов;
//   AllowedHosts — домен сервиса (и localhost — проверки здоровья изнутри контейнера);
//   Cookies__Domain — родительский домен приложений проекта (вход виден всем поддоменам — SSO);
//   ReturnUrls__AllowedOrigins__N, ReturnUrls__Default — куда можно вернуть пользователя после входа;
//   DataProtection__Certificate (PFX в base64, из хранилища секретов) или DataProtection__CertificatePath (файл PFX),
//   DataProtection__CertificatePassword — сертификат, которым шифруются ключи DataProtection в базе (без него дамп базы
//   раскрывает токены управления ключами сервисов); обязателен. На время смены — DataProtection__PreviousCertificate*
//   и Keycloak__PreviousClientSecret (docs/secrets.md).
{
  "DataProtection": {
    "RequireCertificate": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
