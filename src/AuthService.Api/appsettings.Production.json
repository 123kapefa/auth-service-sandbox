// Production: только несекретное и общее для всего прода.
// Секреты передаёт окружение развёртывания (переменные из хранилища секретов):
//   ConnectionStrings__AuthDb — строка подключения целиком (внутри пароль).
// Без обязательных значений сервис не стартует и пишет, чего не хватает.
{
  // Запросы с другим заголовком Host получают 400. localhost — для проверок здоровья изнутри контейнера.
  "AllowedHosts": "auth-sandbox.example;localhost",
  // Сервер входа — отдельный поддомен. Если сервис ходит к нему по внутреннему адресу,
  // задать Authentication__MetadataAddress; iss в токене при этом остаётся Authority.
  "Authentication": {
    "Authority": "https://id.auth-sandbox.example/realms/sandbox"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
