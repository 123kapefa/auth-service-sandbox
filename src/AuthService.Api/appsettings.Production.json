// Production: только несекретное и общее для всего прода.
// Секреты передаёт окружение развёртывания (переменные из хранилища секретов):
//   ConnectionStrings__AuthDb — строка подключения целиком (внутри пароль);
//   Keycloak__ClientSecret — секрет клиента auth-bff;
//   Keycloak__RegistrationToken — разрешение на регистрацию ключей сервисов (scripts/keycloak/registration-token.sh).
// Проект (realm) и адреса ниже — пример: у каждого проекта свои (Authentication__Authority, Cookies__Domain, ReturnUrls__*).
// Без обязательных значений сервис не стартует и пишет, чего не хватает.
{
  // Запросы с другим заголовком Host получают 400. localhost — для проверок здоровья изнутри контейнера.
  "AllowedHosts": "auth-sandbox.example;localhost",
  // Сервер входа — отдельный поддомен. Если сервис ходит к нему по внутреннему адресу,
  // задать Authentication__MetadataAddress; iss в токене при этом остаётся Authority.
  "Authentication": {
    "Authority": "https://id.auth-sandbox.example/realms/sandbox"
  },
  // Cookie на родительском домене — вход виден всем приложениям-поддоменам (SSO).
  "Cookies": {
    "Domain": ".auth-sandbox.example"
  },
  // Куда можно вернуть пользователя после входа — приложения платформы.
  "ReturnUrls": {
    "AllowedOrigins": [ "https://auth-sandbox.example", "https://shop.auth-sandbox.example" ],
    "Default": "https://shop.auth-sandbox.example"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
