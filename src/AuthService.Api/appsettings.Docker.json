{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "AuthService": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  // Демо-проект песочницы: realm sandbox со своими именами клиентов.
  "Authentication": {
    "Authority": "http://localhost:8180/realms/sandbox",
    "Audience": "sandbox-api",
    "MetadataAddress": "http://keycloak:8180/realms/sandbox/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "ClientId": "sandbox-bff"
  },
  "Cookies": {
    "Secure": false
  },
  "ReturnUrls": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  }
}
