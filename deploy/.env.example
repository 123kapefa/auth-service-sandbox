# Сервис входа как компонент — настройки для deploy/compose.yaml. Секреты — из хранилища секретов, не в git:
# пустые значения ниже заполняет развёртывание (без них compose не стартует и пишет, чего не хватает).
# Секреты — только [A-Za-z0-9_-] (например, python3 -c 'import secrets; print(secrets.token_urlsafe(32))'):
# «$» в env-файле подставляется как переменная, «;» ломает строку подключения к базе.
AUTH_VERSION=0.1.0
# Образы релиза — из GHCR (до запуска: docker login ghcr.io); реестр компании — registry.example.com/platform/
AUTH_REGISTRY=ghcr.io/123kapefa/
AUTH_ENVIRONMENT=Production
AUTH_KEYCLOAK_URL=https://id.shop.example.com
AUTH_KEYCLOAK_PORT=8180
AUTH_SERVICE_PORT=8080
# Адрес публикации портов; прокси на другой машине — его адрес в сети (не 0.0.0.0 без прокси).
AUTH_BIND=127.0.0.1
# Бой — start за прокси с https (порт Keycloak — только для прокси). Локально без прокси — start-dev.
# Прокси публикует только /realms/<код проекта> и /resources: /realms/master и мастер-админка (/admin) снаружи закрыты,
# иначе пароль мастер-админа можно перебирать из интернета.
AUTH_KEYCLOAK_COMMAND=start
AUTH_KEYCLOAK_PROXY_HEADERS=xforwarded
# Откуда принимать X-Forwarded-* (адрес прокси).
AUTH_KEYCLOAK_PROXY_TRUSTED=172.16.0.0/12,127.0.0.1
AUTH_KEYCLOAK_ADMIN=admin
AUTH_KEYCLOAK_ADMIN_PASSWORD=
AUTH_KEYCLOAK_DB_PASSWORD=
AUTH_DB_PASSWORD=
# Резервные копии баз по расписанию (docker compose --profile backup up -d, docs/migrations.md): расписание cron (время контейнера — UTC),
# срок хранения в днях и сколько самых свежих копий остаётся всегда. Свои Postgres проекта — их адреса:
# AUTH_BACKUP_SCHEDULE=0 3 * * *
# AUTH_BACKUP_RETENTION_DAYS=14
# AUTH_BACKUP_KEEP_MIN=3
# AUTH_BACKUP_DB_HOST=db.example.com
# AUTH_BACKUP_KEYCLOAK_DB_HOST=db.example.com
# AUTH_BACKUP_PGSSLMODE=require
# Свои Postgres и Redis проекта (тогда auth-db и auth-redis не нужны):
# AUTH_DB_CONNECTION=Host=db;Port=5432;Database=auth_service;Username=auth_service;Password=...
# AUTH_REDIS=redis:6379
# С пользователем (ACL, deploy/redis/redis.conf.example): AUTH_REDIS=redis:6379,user=auth-service,password=...
# Режим при сбое: Redis с отметками отзыва недоступен — Open (по умолчанию: токен пропускается) или Closed (503);
# SmartCaptcha недоступна — pass (по умолчанию: капча пройдена, лимиты действуют) или reject. docs/environments.md.
# AUTH_REVOCATION_ON_STORE_FAILURE=Open
# AUTH_CAPTCHA_ON_OUTAGE=pass
# Проект (realm) и его секрет — из scripts/project/create-project.sh; разрешение на ключи сервисов —
# REALM=$AUTH_REALM scripts/keycloak/registration-token.sh
AUTH_REALM=shop
AUTH_BFF_CLIENT_SECRET=
AUTH_REGISTRATION_TOKEN=
# Ключи realm по внутреннему адресу (http — только вместе с AUTH_REQUIRE_HTTPS=false); пусто — по AUTH_KEYCLOAK_URL.
# AUTH_KEYCLOAK_METADATA_URL=http://auth-keycloak:8180/realms/shop/.well-known/openid-configuration
AUTH_REQUIRE_HTTPS=true
# Домен сервиса входа и localhost (проверки здоровья изнутри контейнера), через «;».
AUTH_ALLOWED_HOSTS=auth.shop.example.com;localhost
AUTH_COOKIES_SECURE=true
AUTH_RETURN_ORIGIN=https://shop.example.com
AUTH_RETURN_DEFAULT=https://shop.example.com/
# Сертификат (PFX, RSA) для ключей DataProtection — PFX в base64 одной строкой и его пароль. Как и остальные секреты,
# хранится в хранилище секретов (docs/secrets.md), файла на машине нет; новый — scripts/secrets/new-pfx.sh.
# Смена сертификата — только с прежним (AUTH_DATA_PROTECTION_PREVIOUS_CERT*, docs/secrets.md): старые ключи
# DataProtection расшифровываются только им, сервис перешифровывает их новым при старте.
AUTH_DATA_PROTECTION_CERT=
AUTH_DATA_PROTECTION_CERT_PASSWORD=
# AUTH_DATA_PROTECTION_PREVIOUS_CERT=
# AUTH_DATA_PROTECTION_PREVIOUS_CERT_PASSWORD=
# Прежний секрет клиента auth-bff — только на время его смены (docs/secrets.md).
# AUTH_BFF_CLIENT_SECRET_PREVIOUS=
# Телефония: адрес провайдера звонков и SMS (с ключом; секрет, в хранилище). Пусто — телефонии нет: коды по номеру не
# отправляются и в лог не пишутся, вход по коду на почту работает.
# AUTH_PHONE_PROVIDER_URL=
# Локально без https: AUTH_KEYCLOAK_URL=http://localhost:8180, AUTH_KEYCLOAK_COMMAND=start-dev, AUTH_REQUIRE_HTTPS=false,
# AUTH_COOKIES_SECURE=false, AUTH_ALLOWED_HOSTS=localhost (окружение — то же Production,
# сертификат DataProtection нужен и локально; AUTH_ENVIRONMENT=Docker — только для стенда песочницы).
