# Сервис входа как компонент — настройки для deploy/compose.yaml. Секреты — из хранилища секретов, не в git:
# пустые значения ниже заполняет развёртывание (без них compose не стартует и пишет, чего не хватает).
# Секреты — только [A-Za-z0-9_-] (например, python3 -c 'import secrets; print(secrets.token_urlsafe(32))'):
# «$» в env-файле подставляется как переменная, «;» ломает строку подключения к базе.
AUTH_VERSION=0.1.0
# AUTH_REGISTRY=registry.example.com/platform/
AUTH_ENVIRONMENT=Production
AUTH_KEYCLOAK_URL=https://id.shop.example.com
AUTH_KEYCLOAK_PORT=8180
AUTH_SERVICE_PORT=8080
# Адрес публикации портов; прокси на другой машине — его адрес в сети (не 0.0.0.0 без прокси).
AUTH_BIND=127.0.0.1
# Бой — start за прокси с https (порт Keycloak — только для прокси). Локально без прокси — start-dev.
AUTH_KEYCLOAK_COMMAND=start
AUTH_KEYCLOAK_PROXY_HEADERS=xforwarded
# Откуда принимать X-Forwarded-* (адрес прокси).
AUTH_KEYCLOAK_PROXY_TRUSTED=172.16.0.0/12,127.0.0.1
AUTH_KEYCLOAK_ADMIN=admin
AUTH_KEYCLOAK_ADMIN_PASSWORD=
AUTH_KEYCLOAK_DB_PASSWORD=
AUTH_DB_PASSWORD=
# Свои Postgres и Redis проекта (тогда auth-db и auth-redis не нужны):
# AUTH_DB_CONNECTION=Host=db;Port=5432;Database=auth_service;Username=auth_service;Password=...
# AUTH_REDIS=redis:6379
# Проект (realm) и его секрет — из scripts/project/create-project.sh; разрешение на ключи сервисов —
# REALM=$AUTH_REALM scripts/keycloak/registration-token.sh
AUTH_REALM=shop
AUTH_BFF_CLIENT_SECRET=
AUTH_REGISTRATION_TOKEN=
# Ключи realm по внутреннему адресу (http — только вместе с AUTH_REQUIRE_HTTPS=false); пусто — по AUTH_KEYCLOAK_URL.
# AUTH_KEYCLOAK_METADATA_URL=http://auth-keycloak:8180/realms/shop/.well-known/openid-configuration
AUTH_REQUIRE_HTTPS=true
# Домен сервиса входа и localhost (проверки здоровья изнутри контейнера), через «;».
AUTH_ALLOWED_HOSTS=auth.shop.example.com;localhost
AUTH_COOKIES_SECURE=true
AUTH_COOKIES_DOMAIN=shop.example.com
AUTH_RETURN_ORIGIN=https://shop.example.com
AUTH_RETURN_DEFAULT=https://shop.example.com/
# Сертификат (PFX, RSA) для ключей DataProtection — абсолютный путь на машине и пароль; например:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj /CN=auth-data-protection -keyout dp.key -out dp.crt
#   openssl pkcs12 -export -inkey dp.key -in dp.crt -out dp.pfx -keypbe AES-256-CBC -certpbe AES-256-CBC -macalg sha256
#   rm dp.key && sudo chown root:1654 dp.pfx && sudo chmod 640 dp.pfx   # читает только сервис (gid 1654)
# Сертификат не менять без переноса: старые ключи DataProtection расшифровываются только им.
AUTH_DATA_PROTECTION_CERT_FILE=
AUTH_DATA_PROTECTION_CERT_PASSWORD=
# Локально без https: AUTH_KEYCLOAK_URL=http://localhost:8180, AUTH_KEYCLOAK_COMMAND=start-dev, AUTH_REQUIRE_HTTPS=false,
# AUTH_COOKIES_SECURE=false, AUTH_COOKIES_DOMAIN=, AUTH_ALLOWED_HOSTS=localhost (окружение — то же Production,
# сертификат DataProtection нужен и локально; AUTH_ENVIRONMENT=Docker — только для стенда песочницы).
